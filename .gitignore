# ─── Dependencies ────────────────────────────────────────────────────────────
**/node_modules
.pnpm-store

# ─── Build outputs ────────────────────────────────────────────────────────────
**/dist
**/.vite
**/.swc
**/.next
# Docusaurus (apps/docs)
**/.docusaurus
apps/docs/build

# ─── TypeScript ───────────────────────────────────────────────────────────────
**/*.tsbuildinfo

# ─── Testing ──────────────────────────────────────────────────────────────────
**/coverage
**/.jest-cache
# Playwright generated output. NOTE: the suites themselves are committed —
# apps/{web,admin}/playwright.config.ts and apps/{web,admin}/e2e/** are
# tracked on purpose and must stay that way. Only run artefacts and any
# locally-installed browser payload are ignored.
# Default output directory — traces, screenshots, videos, .last-run.json
**/test-results
**/playwright-report
# Blob reporter output (used when sharding runs)
**/blob-report
# Browser binaries when installed into the project rather than the OS cache
**/playwright/.cache
**/.playwright
# Throwaway configs used to run a subset of specs locally (e.g. to skip the
# backend preflight in global-setup) — never meant to be committed.
**/playwright.*.config.ts
!**/playwright.config.ts

# ─── Environment — never commit secrets ───────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Monorepo tooling ─────────────────────────────────────────────────────────
.turbo

# ─── Go ───────────────────────────────────────────────────────────────────────
**/tmp/
**/vendor/
# Compiled service binaries — the entry point is cmd/server, so `go build`
# from the service root drops a `server` executable there.
services/*/server

# ─── Prisma ───────────────────────────────────────────────────────────────────
**/prisma/generated
**/*.db
**/*.sqlite

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Uploads / user content ──────────────────────────────────────────────────
# The runtime uploads directory sits at each service's root (created on
# startup, e.g. services/community-service/uploads/). Ignore those but do
# not swallow the source-code package at internal/uploads/.
/uploads/
services/*/uploads/

# ─── Certificates & secrets ──────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12

# ─── Husky internal (hooks themselves ARE committed, this folder is not) ──────
.husky/_

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
# macOS screenshots — both label variants ("Screenshot ..." on 10.15+,
# "Screen Shot ..." on older versions). Ignored so dragging one into
# the repo to share doesn't accidentally get committed.
Screenshot*.png
Screen Shot*.png

# ─── Editor ───────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
.claude/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Local working documents ─────────────────────────────────────────────────
# Reference PDFs kept locally for context but deliberately NOT committed.
# Scoped to these exact paths rather than a blanket *.pdf, because the five
# source documents in docs/product/ (Blueprint, Roadmap, Technical
# Architecture, Experience Architecture, Engineering Playbook) ARE tracked.
/CivicOS Community Funding Feature.pdf
/docs/product/How People Detect AI-Generated Websites.pdf

# ─── Misc ────────────────────────────────────────────────────────────────────
*.local
.cache/
tmp/
temp/
