# ─── Databases ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://civicos:civicos@localhost:5432/civicos"

# ─── Cache ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Messaging ──────────────────────────────────────────────────────
NATS_URL="nats://localhost:4222"

# ─── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-minimum-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Services ───────────────────────────────────────────────────────
IDENTITY_SERVICE_PORT=3001
COMMUNITY_SERVICE_PORT=3002
ORGANIZATION_SERVICE_PORT=3003
CIVICAI_SERVICE_PORT=3004
API_GATEWAY_PORT=3000

# Gateway → service URLs (leave defaults for local dev).
IDENTITY_SERVICE_URL="http://localhost:3001"
COMMUNITY_SERVICE_URL="http://localhost:3002"
ORGANIZATION_SERVICE_URL="http://localhost:3003"
CIVICAI_SERVICE_URL="http://localhost:3004"

# ─── Frontend ───────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3000"

# ─── Email ──────────────────────────────────────────────────────────
# Read by identity-service (verification, password reset) and by
# organization-service (donation receipts). The defaults point at the
# Mailpit container from infrastructure/docker-compose.yml — open
# http://localhost:8025 to read what was sent.
#
# Leave SMTP_HOST empty to fall back to the console mailer, which prints
# messages to the service log instead of sending them.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CivicOS <no-reply@civicos.local>"

# Public origin of the citizen web app. Used to build links inside emails.
APP_URL="http://localhost:5173"

# ─── Flood forecasts · Google Flood Hub ──────────────────────────────
# Read by community-service. Surfaces Google's riverine flood forecasts
# for communities that have coordinates set.
#
# The models are GOOGLE'S, not CivicOS's. Every surface attributes them.
# Get a key at https://developers.google.com/flood-forecasting — the API
# is in PILOT and Google state breaking changes should be expected.
#
# Leave GOOGLE_FLOOD_API_KEY empty and the feature is entirely off: nothing
# is fetched, no route is mounted, no banner appears.
GOOGLE_FLOOD_API_KEY=""

# Minutes between sweeps. 0 disables polling — the kill switch for when the
# pilot API changes under us. One sweep covers the whole country, and the
# upstream allows 200 requests/minute, so hourly is nowhere near the cap.
FLOOD_POLL_INTERVAL_MINUTES=60

# CLDR region code to sweep. NG = Nigeria.
FLOOD_REGION_CODE="NG"

# How far a river gauge can be from a community's point and still be
# considered to cover it. Deliberately generous: a gauge sits on the river,
# and the town that floods is usually downstream of the gauge that reads
# high. The banner always shows the actual distance.
FLOOD_MATCH_RADIUS_KM=50

# ─── Storage ────────────────────────────────────────────────────────
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="civicos-uploads"

# ─── AI (CivicAI) ───────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Legacy — kept for future OpenAI-backed features. Not used by CivicAI.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxx"

# ─── Community Funding · Paystack (Phase 3) ──────────────────────────────
# CivicOS is NOT the merchant of record. Each organization connects its own
# Paystack sub-account and Paystack settles directly to it — these keys are
# the PLATFORM account used to create sub-accounts and initialise splits.
#
# Optional: without them the campaign lifecycle, admin review and public
# pages all still work; only donations are disabled.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CivicOS's cut, in integer BASIS POINTS (250 = 2.5%). Never a percentage
# float — see services/organization-service/internal/donations/money.go.
# Disclosed publicly on the campaign page: a donor should be able to see
# what actually reaches the organization. 0 = full pass-through.
PLATFORM_FEE_BPS=250

# How often (minutes) the reconciliation sweep re-checks the donation ledger
# against Paystack, catching payments whose webhook never arrived. 0 disables.
RECONCILE_INTERVAL_MINUTES=60
