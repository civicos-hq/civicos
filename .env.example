# ─── Databases ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://civicos:civicos@localhost:5432/civicos"

# ─── Cache ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Messaging ──────────────────────────────────────────────────────
NATS_URL="nats://localhost:4222"

# ─── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-minimum-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Services ───────────────────────────────────────────────────────
IDENTITY_SERVICE_PORT=3001
COMMUNITY_SERVICE_PORT=3002
ORGANIZATION_SERVICE_PORT=3003
CIVICAI_SERVICE_PORT=3004
API_GATEWAY_PORT=3000

# Gateway → service URLs (leave defaults for local dev).
IDENTITY_SERVICE_URL="http://localhost:3001"
COMMUNITY_SERVICE_URL="http://localhost:3002"
ORGANIZATION_SERVICE_URL="http://localhost:3003"
CIVICAI_SERVICE_URL="http://localhost:3004"

# ─── Frontend ───────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3000"

# ─── Email ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="CivicOS <noreply@civicos.app>"

# ─── Storage ────────────────────────────────────────────────────────
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="civicos-uploads"

# ─── AI (CivicAI) ───────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Legacy — kept for future OpenAI-backed features. Not used by CivicAI.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxx"

# ─── Community Funding · Paystack (Phase 3) ──────────────────────────────
# CivicOS is NOT the merchant of record. Each organization connects its own
# Paystack sub-account and Paystack settles directly to it — these keys are
# the PLATFORM account used to create sub-accounts and initialise splits.
#
# Optional: without them the campaign lifecycle, admin review and public
# pages all still work; only donations are disabled.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CivicOS's cut, in integer BASIS POINTS (250 = 2.5%). Never a percentage
# float — see services/organization-service/internal/donations/money.go.
# Disclosed publicly on the campaign page: a donor should be able to see
# what actually reaches the organization. 0 = full pass-through.
PLATFORM_FEE_BPS=250
